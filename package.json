{
  "name": "stockviz",
  "version": "2.0.0-alpha.0",
  "private": true,
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @stockviz/web dev",
    "dev:web": "pnpm --filter @stockviz/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint && pnpm run lint:api",
    "lint:api": "uv --directory apps/api run ruff check .",
    "format": "biome format --write . && prettier --write \"**/*.{md,json,yml,yaml}\" --ignore-path .gitignore",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @stockviz/web test",
    "test:coverage": "pnpm --filter @stockviz/web test:coverage",
    "verify:pipeline:clean": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-pipeline-clean.ps1",
    "db:up": "docker compose -f infra/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "stack:up": "docker compose -f infra/docker-compose.yml --profile app up -d --build",
    "stack:down": "docker compose -f infra/docker-compose.yml --profile app down",
    "stack:logs": "docker compose -f infra/docker-compose.yml --profile app logs -f api web",
    "stack:seed": "node apps/web/scripts/seed-demo.mjs",
    "events:up": "docker compose -f infra/docker-compose.yml --profile events up -d",
    "events:down": "docker compose -f infra/docker-compose.yml --profile events down",
    "events:publisher": "uv --directory apps/api run python -m stockviz.workers.outbox_publisher",
    "events:market-ingest": "uv --directory apps/api run python -m stockviz.workers.market_ingest_consumer",
    "events:market-analytics": "uv --directory apps/api run python -m stockviz.workers.market_analytics_consumer",
    "events:news-ingest": "uv --directory apps/api run python -m stockviz.workers.news_ingest_consumer",
    "events:news-sentiment": "uv --directory apps/api run python -m stockviz.workers.news_sentiment_consumer",
    "events:sentiment-aggregate": "uv --directory apps/api run python -m stockviz.workers.sentiment_aggregate_consumer",
    "api:dev": "uv --directory apps/api run uvicorn stockviz.main:app --reload --port 8000",
    "api:migrate": "uv --directory apps/api run alembic upgrade head",
    "e2e": "pnpm --filter @stockviz/web e2e",
    "k8s:create": "bash scripts/k8s/create-kind.sh",
    "k8s:build": "bash scripts/k8s/build-images.sh",
    "k8s:deploy": "bash scripts/k8s/deploy.sh",
    "k8s:smoke": "bash scripts/k8s/smoke.sh",
    "k8s:destroy": "bash scripts/k8s/destroy-kind.sh",
    "k8s:benchmark": "bash scripts/k8s/run-benchmark.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "prettier": "^3.9.6"
  }
}
