# --- App ---
ENVIRONMENT=development
DEBUG=true

# --- Database ---
# Local default matches infra/docker-compose.yml
DATABASE_URL=postgresql+psycopg://stockviz:stockviz_dev@127.0.0.1:5434/stockviz

# --- CORS (comma-separated for prod; JSON array works too) ---
# Production: set to your Vercel URL, e.g. https://stockviz.vercel.app
# CORS_ORIGINS=["http://localhost:3000"]

# --- Auth ---
# Shared secret used by NextAuth to sign JWTs; the API verifies them with this.
# Generate with: openssl rand -base64 32
NEXTAUTH_JWT_SECRET=dev-secret-change-me

# Shared bearer token used by the Next.js server when calling authenticated
# /v1 endpoints. Must match the web app's INTERNAL_API_TOKEN.
INTERNAL_API_TOKEN=dev-internal-token-change-me

# --- External APIs ---
# https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=
# https://newsdata.io/
NEWSDATA_KEY=

# --- Scheduler ---
# Off by default so tests / CLI runs don't fire jobs. Render flips this on.
ENABLE_SCHEDULER=false

# --- Sentry (optional; leave blank to disable) ---
# https://sentry.io -> your project -> Settings -> Client Keys (DSN)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
