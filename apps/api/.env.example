# --- App ---
ENVIRONMENT=development
DEBUG=true

# --- Database ---
# Local default matches infra/docker-compose.yml
DATABASE_URL=postgresql+psycopg://stockviz:stockviz_dev@127.0.0.1:5434/stockviz

# --- CORS (comma-separated for prod; JSON array works too) ---
# Production: set to your Vercel URL, e.g. https://stockviz.vercel.app
# CORS_ORIGINS=["http://localhost:3000"]

# --- Auth ---
# NextAuth signs *session* JWTs with AUTH_SECRET on the web app. The API does
# not read that cookie. Authenticated /v1 calls use INTERNAL_API_TOKEN (below).
#
# NEXTAUTH_JWT_SECRET is unused leftover from an earlier bridge design. Kept
# so existing deployments that still set it don't trip config drift. You do
# not need to generate a unique value for new local setups.
NEXTAUTH_JWT_SECRET=dev-secret-change-me

# Shared HS256 secret used by the Next.js server to mint a 60 s JWT for
# authenticated /v1 calls. Must match the web app's INTERNAL_API_TOKEN.
INTERNAL_API_TOKEN=dev-internal-token-change-me

# --- External APIs ---
# Daily OHLCV: yfinance is primary (no key). Alpha Vantage is fallback only.
# https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=
# Private/local Massive comparison only. It is never persisted or served.
# Explicit enablement fails startup if MASSIVE_API_KEY is blank.
MASSIVE_SHADOW_ENABLED=false
MASSIVE_API_KEY=
MASSIVE_SHADOW_LOOKBACK_DAYS=90
# https://newsdata.io/
# Blank preserves legacy behavior: newsdata when NEWSDATA_KEY is present,
# otherwise none. Explicit NEWS_PROVIDER=newsdata requires the key.
NEWS_PROVIDER=
NEWSDATA_KEY=
# https://console.anthropic.com/ — used to score news-headline sentiment on ingest.
# Leave blank to skip sentiment scoring (existing/new rows keep sentiment NULL).
ANTHROPIC_API_KEY=

# --- Sentiment scoring ---
# Which provider scores news: "none" (default) | "anthropic" | "http".
# Left blank it resolves to "anthropic" when ANTHROPIC_API_KEY is set, else
# "none" — so nothing changes for a deployment that predates this setting.
SENTIMENT_PROVIDER=
# Only used when SENTIMENT_PROVIDER=http. A standalone scoring service; see
# docs/SENTIMENT.md for the request/response contract.
SENTIMENT_SERVICE_URL=
SENTIMENT_SERVICE_TOKEN=
# Recorded against scores when the service doesn't name its own model.
SENTIMENT_MODEL_HINT=external
# Ceiling on documents scored per ingest/backfill run, so a runaway job can't
# quietly burn an API budget.
SENTIMENT_DAILY_DOCUMENT_CAP=2000

# --- Scheduler ---
# Off by default so tests / CLI runs don't fire jobs. Render flips this on.
ENABLE_SCHEDULER=false

# --- Rate limiting ---
# slowapi is on by default. Set to 0 to disable (tests already do this).
# RATELIMIT_ENABLED=0

# --- Sentry (optional; leave blank to disable) ---
# https://sentry.io -> your project -> Settings -> Client Keys (DSN)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Kafka (workers only; the API never connects) ---
# Local broker: pnpm events:up  (compose profile "events", KRaft, no ZooKeeper)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TRADES_TOPIC=stockviz.trades.v1
KAFKA_CONSUMER_GROUP=stockviz.trade-activity.v1
OUTBOX_BATCH_SIZE=50
OUTBOX_POLL_INTERVAL_SECONDS=1.0
# Optional worker tuning. Topic names and consumer groups are versioned
# constants (stockviz.market.v1 / stockviz.news.v1 / stockviz.market-ingestion.v1 …).
KAFKA_POLL_TIMEOUT_SECONDS=1.0
KAFKA_RETRY_BACKOFF_SECONDS=2.0
