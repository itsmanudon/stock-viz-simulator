# StockViz web app — environment variables.
#
# Copy to .env.local for local dev. Values committed here are safe dev
# defaults (matching infra/docker-compose.yml); real secrets stay out of git.

# --- Backend ---
# We use 127.0.0.1 (not localhost) so Windows IPv6 lookups don't bypass it.
# See docs/SETUP.md (Windows IPv6 note).
API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# --- Database ---
# Shared Postgres (docker-compose). Used by the auth layer to read/write
# the users table.
DATABASE_URL=postgres://stockviz:stockviz_dev@127.0.0.1:5434/stockviz

# --- Server-to-server auth with FastAPI ---
# Must match apps/api .env's INTERNAL_API_TOKEN. The Next.js server mints a
# 60 s HS256 JWT signed with this secret (sub = db user id) and sends it as
# Authorization: Bearer <jwt>. The raw token is never the Bearer value, and
# the browser never sees it.
INTERNAL_API_TOKEN=dev-internal-token-change-me

# --- NextAuth v5 ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=dev-secret-change-me
# AUTH_URL is intentionally unset in dev. NextAuth trusts the request host
# when NODE_ENV !== "production", so it works on whatever port Next.js binds
# (3000, 3001, 3005, ...). Set it ONLY in production:
# AUTH_URL=https://your-domain.vercel.app

# --- OAuth ---
# Get these from https://console.cloud.google.com → APIs & Services → Credentials
# Create an OAuth 2.0 Client ID (Web application).
# Authorised redirect URI: https://<your-domain>/api/auth/callback/google
# For local dev add:       http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Sentry (optional; leave blank to disable) ---
# Browser DSN must be public so the client SDK can use it.
NEXT_PUBLIC_SENTRY_DSN=
# Server-side DSN (usually identical to the browser one).
SENTRY_DSN=
# Only needed in CI/prod builds — uploads source maps. Leave blank locally.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
