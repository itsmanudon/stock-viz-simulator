# StockViz self-hosting (A10.1). Copy to infra/release.env (gitignored) and
# fill the three secrets. Generate each with: openssl rand -base64 32
POSTGRES_PASSWORD=
INTERNAL_API_TOKEN=
AUTH_SECRET=

# true runs the nightly jobs inside the API; false means you run them.
ENABLE_SCHEDULER=true

# Optional providers. Blank = that feature is off. Your own keys only.
ALPHA_VANTAGE_KEY=
SEC_USER_AGENT=
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
TIINGO_API_KEY=
FINNHUB_API_KEY=
MASSIVE_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
TELEGRAM_BOT_TOKEN=
