# Secrets for the docker "app" profile (pnpm stack:up).
#
# The web image runs a production build, and lib/env.ts deliberately refuses
# the dev defaults committed to this repo when NODE_ENV=production — otherwise
# anyone could mint a bridge JWT for any user. So the stack needs real values
# even locally.
#
# Copy to infra/.env and fill in. Generate each with:
#   openssl rand -base64 32
#
# INTERNAL_API_TOKEN must be IDENTICAL for the web and api services; a mismatch
# makes every authenticated /v1 call 401.
AUTH_SECRET=
INTERNAL_API_TOKEN=

# --- Optional provider config (all blank = feature disabled, stack still boots) ---
#
# Compose does NOT read apps/api/.env, so a key that only lives there never
# reaches the container: news ingest and sentiment scoring then no-op silently.
# Set them here to run the ingest -> sentiment pipeline against the app stack.

# https://www.alphavantage.co/support/#api-key — daily-bar fallback only.
ALPHA_VANTAGE_KEY=
# https://newsdata.io/ — without this `stockviz.cli news` refuses to run.
NEWSDATA_KEY=

# Sentiment: "none" (default) | "anthropic" | "http".
SENTIMENT_PROVIDER=
ANTHROPIC_API_KEY=
# Only read when SENTIMENT_PROVIDER=http. From inside compose, a scoring
# service published on the host is reachable at host.docker.internal.
#   SENTIMENT_SERVICE_URL=http://host.docker.internal:18000
SENTIMENT_SERVICE_URL=
SENTIMENT_SERVICE_TOKEN=
# Model name recorded when the service does not report one of its own.
SENTIMENT_MODEL_HINT=
