# Secrets for the docker "app" profile (pnpm stack:up).
#
# The web image runs a production build, and lib/env.ts deliberately refuses
# the dev defaults committed to this repo when NODE_ENV=production — otherwise
# anyone could mint a bridge JWT for any user. So the stack needs real values
# even locally.
#
# Copy to infra/.env and fill in. Generate each with:
#   openssl rand -base64 32
#
# INTERNAL_API_TOKEN must be IDENTICAL for the web and api services; a mismatch
# makes every authenticated /v1 call 401.
AUTH_SECRET=
INTERNAL_API_TOKEN=
