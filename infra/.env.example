# Secrets for the docker "app" profile (pnpm stack:up).
#
# The web image runs a production build, and lib/env.ts deliberately refuses
# the dev defaults committed to this repo when NODE_ENV=production — otherwise
# anyone could mint a bridge JWT for any user. So the stack needs real values
# even locally.
#
# Copy to infra/.env and fill in. Generate each with:
#   openssl rand -base64 32
#
# INTERNAL_API_TOKEN must be IDENTICAL for the web and api services; a mismatch
# makes every authenticated /v1 call 401.
AUTH_SECRET=
INTERNAL_API_TOKEN=

# Optional local pilot: docker compose -f infra/docker-compose.yml --profile cache up -d redis
# Keep none for ordinary reads. Set a generated password before starting Redis.
CACHE_BACKEND=none
REDIS_PASSWORD=

# --- Optional provider config (all blank = feature disabled, stack still boots) ---
#
# Compose does NOT read apps/api/.env, so a key that only lives there never
# reaches the container: the fallback or shadow it enables then no-ops silently.
# News comes from Aegis News (`stockviz.cli aegis-sync`); StockViz fetches none.

# https://www.alphavantage.co/support/#api-key — daily-bar fallback only.
ALPHA_VANTAGE_KEY=
# Massive Individual credentials are private/local shadow-use only. Never
# expose Massive-derived data via the API or web app. Explicit enablement
# fails startup when the key is absent.
MASSIVE_SHADOW_ENABLED=false
MASSIVE_API_KEY=
MASSIVE_SHADOW_LOOKBACK_DAYS=90
